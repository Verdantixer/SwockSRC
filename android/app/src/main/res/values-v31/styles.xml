<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:navigationBarColor">@color/swock_navigation</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/swock_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/swock_background</item>
        <item name="android:windowSplashScreenAnimationDuration">850</item>
        <item name="android:windowBackground">@color/swock_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:navigationBarColor">@color/swock_navigation</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
